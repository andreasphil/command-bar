{
  "name": "@andreasphil/command-bar",
  "version": "0.15.0",
  "description": "⌘K command bar web component",
  "license": "MIT",
  "author": "Andreas Philippi",
  "repository": "https://github.com/andreasphil/command-bar",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/commandBar.js",
      "types": "./dist/commandBar.d.ts"
    }
  },
  "scripts": {
    "build": "node --run build:bundle && node --run build:types",
    "build:bundle": "vite build",
    "build:types": "tsc",
    "dev": "vite",
    "preversion": "node --run test && node --run build && git add dist/",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@andreasphil/design-system": "github:andreasphil/design-system#v0.61.0",
    "lit-html": "^3.3.3",
    "nanostores": "^1.4.2"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "bundleDependencies": [
    "lit-html",
    "nanostores"
  ]
}
