{
  "name": "@andreasphil/command-bar",
  "version": "0.18.0",
  "description": "⌘K command bar web component",
  "license": "MIT",
  "author": "Andreas Philippi",
  "repository": "https://github.com/andreasphil/command-bar",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/commandBar.js",
      "types": "./dist/commandBar.d.ts"
    }
  },
  "scripts": {
    "build": "node --run build:bundle && node --run build:types",
    "build:bundle": "vite build",
    "build:types": "tsc",
    "dev": "vite",
    "preversion": "node --run test && node --run build && git add dist/",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@andreasphil/design-system": "github:andreasphil/design-system#v0.65.0",
    "lit-html": "3.3.3",
    "nanostores": "1.5.5"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "bundleDependencies": [
    "lit-html",
    "nanostores"
  ]
}
