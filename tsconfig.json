{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "target": "esnext",
    "verbatimModuleSyntax": true
  },
  "exclude": ["**/*.config.js", "./dist/**/*"],
  "include": ["**/*.js", "**/*.ts"]
}
